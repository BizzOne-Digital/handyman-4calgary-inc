# --- Required ---
# MongoDB Atlas connection string (include the database name)
MONGODB_URI="mongodb+srv://bizzone:bizzone@cluster0.bwpdzae.mongodb.net/handyman4calgary?retryWrites=true&w=majority&appName=Cluster0"

# Public site URL, used for canonical URLs, sitemap and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://handyman4calgary.com"

# Long random string used to hash IP addresses for rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# --- Optional: enquiry email notifications (Resend) ---
# Enquiries are always saved to MongoDB; email is an extra notification only.
RESEND_API_KEY=""
NOTIFY_EMAIL_TO="info@handyman4calgary.com"
NOTIFY_EMAIL_FROM="Handyman 4 Calgary Website <website@handyman4calgary.com>"
